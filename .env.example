# ==============================================================================
# GatecodeXcars24 — Environment Configuration Template (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.local for local development.
# 2. Never commit actual secret values or real credentials to source control.
# 3. For production, set these variables securely in your deployment hosting platform.
# ==============================================================================

# Database Connection (Required)
# MongoDB Atlas or local MongoDB connection URI
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gatecode_cars24?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/gatecode_bpo

# Authentication & Security (Required)
# Generate a cryptographically secure 256-bit secret (e.g., using `openssl rand -hex 32`)
JWT_SECRET=your_secure_random_jwt_secret_here_min_32_chars
JWT_EXPIRES_IN=7d

# Initial Administrator Provisioning (Required for first-time seeding)
# ADMIN_PASSWORD is strictly required to provision the initial administrator.
# There is NO default or fallback password in the application code.
ADMIN_EMAIL=admin@gatecodexcars24.com
ADMIN_PASSWORD=your_strong_admin_password_here
ADMIN_NAME=System Administrator

# Application Runtime Configuration (Optional)
NODE_ENV=development
PORT=3000
